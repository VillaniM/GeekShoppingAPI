@model IEnumerable<GeekShopping.Web.Models.ProductModel>

<br />
<br />
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col">
            <h2 class="text-primary">Products List</h2>
        </div>
        <div class="col text-end pt-1">
            <a asp-action="CreateProduct" class="btn btn-outline-primary">
                <i class="fa fa-plus" aria-hidden="true"></i>&nbsp;Create Product
            </a>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">CategoryName</th>
                <th scope="col">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                            <i class="fa fa-pencil" aria-hidden="true"></i>&nbsp;Edit
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="DeleteProduct" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="fa fa-trash" aria-hidden="true"></i>&nbsp;Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>