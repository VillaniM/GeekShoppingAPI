@model IEnumerable<GeekShopping.Web.Models.ProductModel>

<form>
    <div class="container">
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (ProductModel product in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <img class="card-img-top" src="@product.ImageUrl" alt="@product.Name"
                            style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title" style="height: 50px; overflow: hidden;">
                                @product.SubstringName()
                            </h5>
                            <p class="card-text" style="height: 80px; overflow: hidden;">
                                @Html.Raw(product.SubstringDescription())
                            </p>
                            <p class="card-text">Preço: @product.Price.ToString("C")</p>
                            <a href="@Url.Action("ProductDetails", "Product", new { id = product.Id })"
                            class="btn btn-success mt-auto">Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</form>